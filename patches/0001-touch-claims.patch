+// ---------------------------------------------------------------------------------------
+// Plugin touch claims: a finger-down on the game is offered to RuneLite's MouseManager
+// listeners (never the game) as a BUTTON1 press. When a listener consumes it, that touch
+// belongs to the plugin: drags and the lift go to MouseManager too, so the plugin sees the
+// finger land and lift in real time (hold-style on-screen keys need this).
+// ---------------------------------------------------------------------------------------
+
+private fun tryPluginClaim(pos: Offset, boxSize: IntSize): PluginTouchClaim? {
+    return try {
+        val window = java.awt.Window.primaryFrame() ?: return null
+        val (winX, winY) = composeToWindow(pos, boxSize, window) ?: return null
+        val hit = hitTest(window, winX, winY) ?: return null
+        val canvas = ancestorChain(hit.comp).firstOrNull { it is java.awt.Canvas } as? java.awt.Canvas
+            ?: return null
+        val origin = hitTestExact(window, canvas) ?: return null
+        val manager = net.runelite.mp.ui.bridge.RuneLiteAccess.instance(
+            net.runelite.client.input.MouseManager::class.java) ?: return null
+        val claim = PluginTouchClaim(window, canvas, origin.absX, origin.absY, manager)
+        if (claim.press(winX - origin.absX, winY - origin.absY)) claim else null
+    } catch (t: Throwable) {
+        android.util.Log.w("PluginTouchClaim", "claim probe failed", t)
+        null
+    }
+}
+
+private class PluginTouchClaim(
+    private val window: java.awt.Window,
+    private val canvas: java.awt.Canvas,
+    private val originX: Int,
+    private val originY: Int,
+    private val manager: net.runelite.client.input.MouseManager,
+) {
+    private var x = 0 // touch thread only
+    private var y = 0
+
+    /**
+     * Offers the press to RuneLite's mouse listeners on the EDT and waits for the answer, but
+     * never longer than [PROBE_TIMEOUT_MS]: a busy EDT must not hold up every touch. If the
+     * answer comes late, the touch is handled as an ordinary gesture, and a late claim gets
+     * its release straight away so the plugin is never left holding a press.
+     */
+    fun press(lx: Int, ly: Int): Boolean {
+        x = lx; y = ly
+        val pressed = event(java.awt.event.MouseEvent.MOUSE_PRESSED, java.awt.event.InputEvent.BUTTON1_DOWN_MASK, lx, ly)
+        val lateRelease = event(java.awt.event.MouseEvent.MOUSE_RELEASED, 0, lx, ly)
+        val lateClick = event(java.awt.event.MouseEvent.MOUSE_CLICKED, 0, lx, ly)
+        val lock = Any()
+        var answered = false
+        var consumed = false
+        var abandoned = false
+        val done = java.util.concurrent.CountDownLatch(1)
+        java.awt.EventQueue.invokeLater {
+            val claimed = try {
+                manager.processMousePressed(pressed).isConsumed
+            } catch (t: Throwable) {
+                android.util.Log.w("PluginTouchClaim", "press failed", t)
+                false
+            }
+            synchronized(lock) {
+                answered = true
+                consumed = claimed
+                if (abandoned && claimed) {
+                    manager.processMouseReleased(lateRelease)
+                    manager.processMouseClicked(lateClick)
+                }
+            }
+            done.countDown()
+        }
+        done.await(PROBE_TIMEOUT_MS, java.util.concurrent.TimeUnit.MILLISECONDS)
+        synchronized(lock) {
+            if (answered) return consumed
+            abandoned = true
+        }
+        android.util.Log.i("PluginTouchClaim", "EDT busy for ${PROBE_TIMEOUT_MS}ms; touch handled normally")
+        return false
+    }
+
+    /** Fire-and-forget: the EDT runs events in order, so drags and the release stay in sequence. */
+    fun drag(pos: Offset, boxSize: IntSize) {
+        val (wx, wy) = composeToWindow(pos, boxSize, window, clamp = true) ?: return
+        x = wx - originX; y = wy - originY
+        val e = event(java.awt.event.MouseEvent.MOUSE_DRAGGED, java.awt.event.InputEvent.BUTTON1_DOWN_MASK, x, y)
+        java.awt.EventQueue.invokeLater { manager.processMouseDragged(e) }
+    }
+
+    fun release() {
+        val released = event(java.awt.event.MouseEvent.MOUSE_RELEASED, 0, x, y)
+        val clicked = event(java.awt.event.MouseEvent.MOUSE_CLICKED, 0, x, y)
+        java.awt.EventQueue.invokeLater {
+            manager.processMouseReleased(released)
+            manager.processMouseClicked(clicked)
+        }
+    }
+
+    private fun event(id: Int, mods: Int, ex: Int, ey: Int): java.awt.event.MouseEvent {
+        val dragged = id == java.awt.event.MouseEvent.MOUSE_DRAGGED
+        return java.awt.event.MouseEvent(
+            canvas, id, System.currentTimeMillis(), mods, ex, ey,
+            if (dragged) 0 else 1, false,
+            if (dragged) java.awt.event.MouseEvent.NOBUTTON else java.awt.event.MouseEvent.BUTTON1,
+        )
+    }
+
+    companion object {
+        /** About three frames at 60 Hz. Past this, a touch goes the normal way. */
+        const val PROBE_TIMEOUT_MS = 50L
+    }
+}

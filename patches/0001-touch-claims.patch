diff --git a/android/src/androidMain/kotlin/net/runelite/mp/AppAndroid.kt b/android/src/androidMain/kotlin/net/runelite/mp/AppAndroid.kt
index ef873a3..3f3c31c 100644
--- a/android/src/androidMain/kotlin/net/runelite/mp/AppAndroid.kt
+++ b/android/src/androidMain/kotlin/net/runelite/mp/AppAndroid.kt
@@ -411,6 +411,75 @@ private fun GameViewport(modifier: Modifier = Modifier) {
                     // Mouse and touchpad presses belong to MouseBridge; awaitEachGesture then
                     // waits for every pointer to come up before looking for the next touch.
                     if (pointerKind(currentEvent) != PointerKind.Touch) return@awaitEachGesture
+                    // Offer the touch to RuneLite's mouse listeners before deciding on a
+                    // gesture. A plugin that consumes the press owns the touch until lift:
+                    // it gets the drags and the release, and no tap, long-press or camera
+                    // drag reaches the game.
+                    val claim = tryPluginClaim(down.position, boxSize)
+                    if (claim != null) {
+                        down.consume()
+                        // Other fingers keep working while the claimed one is down: a quick
+                        // tap from a second finger is a normal left click on the game, so a
+                        // held Shift bubble plus a tap on an item drops it, as on desktop, and
+                        // a second finger dragging is a normal drag (camera over the scene).
+                        val otherDown = HashMap<androidx.compose.ui.input.pointer.PointerId, Pair<Offset, Long>>()
+                        val otherMoved = HashSet<androidx.compose.ui.input.pointer.PointerId>()
+                        var claimedUp = false
+                        var otherDrag: DragSession? = null
+                        var otherDragId: androidx.compose.ui.input.pointer.PointerId? = null
+                        try {
+                            while (true) {
+                                val ev = awaitPointerEvent(PointerEventPass.Main)
+                                for (o in ev.changes) {
+                                    if (o.id == down.id) continue
+                                    if (o.pressed && !o.previousPressed) {
+                                        otherDown[o.id] = o.position to System.currentTimeMillis()
+                                    } else if (o.pressed) {
+                                        val start = otherDown[o.id]
+                                        if (o.id == otherDragId) {
+                                            otherDrag?.update(o.position, boxSize)
+                                        } else if (start != null && o.id !in otherMoved &&
+                                            (o.position - start.first).getDistance() > viewConfiguration.touchSlop) {
+                                            otherMoved += o.id
+                                            // One drag at a time, like the normal one-finger path.
+                                            if (otherDrag == null) {
+                                                otherDrag = beginDrag(start.first, o.position, boxSize,
+                                                    System.currentTimeMillis() - start.second)
+                                                if (otherDrag != null) otherDragId = o.id
+                                            }
+                                        }
+                                    } else if (o.previousPressed) {
+                                        if (o.id == otherDragId) {
+                                            otherDrag?.end()
+                                            otherDrag = null
+                                            otherDragId = null
+                                        }
+                                        val start = otherDown.remove(o.id)
+                                        val quick = start != null &&
+                                            System.currentTimeMillis() - start.second < viewConfiguration.longPressTimeoutMillis
+                                        if (quick && o.id !in otherMoved) dispatchClick(start!!.first, boxSize, BUTTON1)
+                                        otherMoved -= o.id
+                                    }
+                                }
+                                val c = ev.changes.firstOrNull { it.id == down.id }
+                                ev.changes.forEach { it.consume() }
+                                if (!claimedUp) {
+                                    if (c == null || c.changedToUpIgnoreConsumed() || !c.pressed) {
+                                        claimedUp = true
+                                        claim.release()
+                                    } else {
+                                        claim.drag(c.position, boxSize)
+                                    }
+                                }
+                                // The gesture ends once every finger is up.
+                                if (ev.changes.none { it.pressed }) break
+                            }
+                        } finally {
+                            otherDrag?.end()
+                            if (!claimedUp) claim.release()
+                        }
+                        return@awaitEachGesture
+                    }
                     val downId = down.id
                     val downTime = System.currentTimeMillis()
                     var lastPos: Offset = down.position
@@ -1748,3 +1817,113 @@ private class MouseBridge {
         private const val MULTI_CLICK_MS = 500L
     }
 }

diff --git a/runelite-client/src/main/java/com/touchkeys/TouchKeysOverlay.java b/runelite-client/src/main/java/com/touchkeys/TouchKeysOverlay.java
new file mode 100644
index 0000000..d392718
--- /dev/null
+++ b/runelite-client/src/main/java/com/touchkeys/TouchKeysOverlay.java
@@ -0,0 +1,83 @@
+package com.touchkeys;
+
+import java.awt.BasicStroke;
+import java.awt.Color;
+import java.awt.Dimension;
+import java.awt.Font;
+import java.awt.FontMetrics;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.Stroke;
+import javax.inject.Inject;
+import net.runelite.client.ui.FontManager;
+import net.runelite.client.ui.overlay.Overlay;
+import net.runelite.client.ui.overlay.OverlayLayer;
+import net.runelite.client.ui.overlay.OverlayPosition;
+
+class TouchKeysOverlay extends Overlay
+{
+	private static final Stroke OUTLINE = new BasicStroke(2f);
+	private static final Stroke EDIT_OUTLINE = new BasicStroke(2f, BasicStroke.CAP_BUTT, BasicStroke.JOIN_MITER,
+		10f, new float[]{6f, 4f}, 0f);
+	private static final Color EDIT_COLOR = new Color(80, 200, 255);
+
+	private final TouchKeysPlugin plugin;
+	private final TouchKeysConfig config;
+
+	@Inject
+	TouchKeysOverlay(TouchKeysPlugin plugin, TouchKeysConfig config)
+	{
+		this.plugin = plugin;
+		this.config = config;
+		// DYNAMIC: we draw at our own canvas coordinates, which match the mouse/touch coordinates.
+		setPosition(OverlayPosition.DYNAMIC);
+		setLayer(OverlayLayer.ALWAYS_ON_TOP);
+		setPriority(PRIORITY_HIGHEST);
+	}
+
+	@Override
+	public Dimension render(Graphics2D g)
+	{
+		g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+		g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
+
+		final int size = config.bubbleSize();
+		final boolean editing = config.editLayout();
+		final Font font = FontManager.getRunescapeBoldFont().deriveFont(Math.max(12f, size / 4f));
+
+		for (Bubble b : plugin.getBubbles())
+		{
+			if (!b.isEnabled())
+			{
+				continue;
+			}
+
+			boolean lit = b.isKeyDown() || b.isTouching();
+			g.setColor(lit ? config.activeColor() : config.idleColor());
+			g.fillOval(b.getX(), b.getY(), size, size);
+
+			g.setStroke(editing ? EDIT_OUTLINE : OUTLINE);
+			g.setColor(editing ? EDIT_COLOR : new Color(255, 255, 255, 180));
+			g.drawOval(b.getX(), b.getY(), size, size);
+
+			// A small dot shows a Toggle key that is locked down.
+			if (b.getMode() == KeyMode.TOGGLE && b.isKeyDown())
+			{
+				int d = Math.max(6, size / 8);
+				g.setColor(Color.WHITE);
+				g.fillOval(b.getX() + size / 2 - d / 2, b.getY() + d, d, d);
+			}
+
+			String text = b.displayLabel();
+			g.setFont(font);
+			FontMetrics fm = g.getFontMetrics();
+			int tx = b.getX() + (size - fm.stringWidth(text)) / 2;
+			int ty = b.getY() + (size - fm.getHeight()) / 2 + fm.getAscent();
+			g.setColor(Color.BLACK);
+			g.drawString(text, tx + 1, ty + 1);
+			g.setColor(Color.WHITE);
+			g.drawString(text, tx, ty);
+		}
+		return null;
+	}
+}
diff --git a/runelite-client/src/main/java/com/touchkeys/TouchKeysPlugin.java b/runelite-client/src/main/java/com/touchkeys/TouchKeysPlugin.java
new file mode 100644
index 0000000..c6f0e88
--- /dev/null
+++ b/runelite-client/src/main/java/com/touchkeys/TouchKeysPlugin.java
@@ -0,0 +1,331 @@
+package com.touchkeys;
+
+import com.google.inject.Provides;
+import java.awt.Canvas;
+import java.awt.Point;
+import java.awt.event.MouseEvent;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import javax.inject.Inject;
+import javax.swing.SwingUtilities;
+import lombok.Getter;
+import lombok.extern.slf4j.Slf4j;
+import net.runelite.api.Client;
+import net.runelite.api.events.FocusChanged;
+import net.runelite.client.config.ConfigManager;
+import net.runelite.client.eventbus.Subscribe;
+import net.runelite.client.events.ConfigChanged;
+import net.runelite.client.input.MouseAdapter;
+import net.runelite.client.input.MouseManager;
+import net.runelite.client.plugins.Plugin;
+import net.runelite.client.plugins.PluginDescriptor;
+import net.runelite.client.ui.overlay.OverlayManager;
+
+@Slf4j
+@PluginDescriptor(
+	name = "Touch Keys",
+	description = "On-screen bubbles that act like keyboard keys (Shift, Space, numbers...) for touchscreens",
+	tags = {"touch", "touchscreen", "mobile", "tablet", "keyboard", "shift", "accessibility"}
+)
+public class TouchKeysPlugin extends Plugin
+{
+	static final int BUBBLE_COUNT = 4;
+
+	@Inject
+	private Client client;
+
+	@Inject
+	private TouchKeysConfig config;
+
+	@Inject
+	private ConfigManager configManager;
+
+	@Inject
+	private OverlayManager overlayManager;
+
+	@Inject
+	private MouseManager mouseManager;
+
+	@Inject
+	private TouchKeysOverlay overlay;
+
+	@Inject
+	private KeyDispatcher dispatcher;
+
+	@Getter
+	private final List<Bubble> bubbles;
+
+	// Touch state below is only touched on the Swing event thread.
+	private Bubble activeBubble;
+	private Point dragOffset;
+	private boolean swallowNextClick;
+
+	public TouchKeysPlugin()
+	{
+		List<Bubble> list = new ArrayList<>();
+		for (int i = 1; i <= BUBBLE_COUNT; i++)
+		{
+			list.add(new Bubble(i));
+		}
+		bubbles = Collections.unmodifiableList(list);
+	}
+
+	@Provides
+	TouchKeysConfig provideConfig(ConfigManager configManager)
+	{
+		return configManager.getConfig(TouchKeysConfig.class);
+	}
+
+	@Override
+	protected void startUp()
+	{
+		loadBubbles();
+		overlayManager.add(overlay);
+		mouseManager.registerMouseListener(mouseListener);
+	}
+
+	@Override
+	protected void shutDown()
+	{
+		mouseManager.unregisterMouseListener(mouseListener);
+		overlayManager.remove(overlay);
+		onEdt(this::releaseEverything);
+	}
+
+	@Subscribe
+	public void onConfigChanged(ConfigChanged event)
+	{
+		if (!TouchKeysConfig.GROUP.equals(event.getGroup()))
+		{
+			return;
+		}
+		String key = event.getKey();
+		if (key.matches("bubble\\d[XY]"))
+		{
+			// Our own position save; nothing else to do.
+			return;
+		}
+		onEdt(() ->
+		{
+			// A key/mode change on a held bubble must not leave a key stuck down.
+			releaseEverything();
+			loadBubbles();
+		});
+	}
+
+	@Subscribe
+	public void onFocusChanged(FocusChanged event)
+	{
+		// The game drops all held keys when the window loses focus; stay in sync with it.
+		if (!event.isFocused())
+		{
+			onEdt(this::releaseEverything);
+		}
+	}
+
+	private final MouseAdapter mouseListener = new MouseAdapter()
+	{
+		@Override
+		public MouseEvent mousePressed(MouseEvent e)
+		{
+			// Touchscreens deliver taps as left-button presses. While moving bubbles, also take
+			// middle-button drags: the RuneLite Android app turns a finger drag over the game
+			// into a middle-button (camera) drag.
+			boolean moving = config.editLayout();
+			if (e.getButton() != MouseEvent.BUTTON1 && !(moving && e.getButton() == MouseEvent.BUTTON2))
+			{
+				return e;
+			}
+			Bubble b = bubbleAt(e.getPoint());
+			if (b == null)
+			{
+				swallowNextClick = false;
+				return e;
+			}
+			e.consume();
+			activeBubble = b;
+			b.setTouching(true);
+
+			if (config.editLayout())
+			{
+				dragOffset = new Point(e.getX() - b.getX(), e.getY() - b.getY());
+				return e;
+			}
+
+			// Keys go to the focused component, as with a real keyboard; make sure that's the game.
+			Canvas canvas = client.getCanvas();
+			if (canvas != null && !canvas.isFocusOwner())
+			{
+				canvas.requestFocusInWindow();
+			}
+
+			KeyOption key = b.getKey();
+			switch (b.getMode())
+			{
+				case HOLD:
+					dispatcher.press(key);
+					b.setKeyDown(true);
+					break;
+				case TOGGLE:
+					if (b.isKeyDown())
+					{
+						dispatcher.release(key);
+						b.setKeyDown(false);
+					}
+					else
+					{
+						dispatcher.press(key);
+						b.setKeyDown(true);
+					}
+					break;
+			}
+			return e;
+		}
+
+		@Override
+		public MouseEvent mouseDragged(MouseEvent e)
+		{
+			if (activeBubble == null)
+			{
+				return e;
+			}
+			e.consume();
+			if (config.editLayout() && dragOffset != null)
+			{
+				// Game-space size: in Stretched Mode (on by default in the Android app) the
+				// AWT canvas is larger than the game, but touches arrive in game coordinates.
+				Canvas canvas = client.getCanvas();
+				int size = config.bubbleSize();
+				int width = client.getCanvasWidth() > 0 ? client.getCanvasWidth()
+					: canvas != null ? canvas.getWidth() : Integer.MAX_VALUE;
+				int height = client.getCanvasHeight() > 0 ? client.getCanvasHeight()
+					: canvas != null ? canvas.getHeight() : Integer.MAX_VALUE;
+				int maxX = width - size;
+				int maxY = height - size;
+				activeBubble.setX(clamp(e.getX() - dragOffset.x, 0, maxX));
+				activeBubble.setY(clamp(e.getY() - dragOffset.y, 0, maxY));
+			}
+			return e;
+		}
+
+		@Override
+		public MouseEvent mouseReleased(MouseEvent e)
+		{
+			Bubble b = activeBubble;
+			if (b == null)
+			{
+				return e;
+			}
+			e.consume();
+			activeBubble = null;
+			swallowNextClick = true;
+			b.setTouching(false);
+
+			if (config.editLayout())
+			{
+				dragOffset = null;
+				configManager.setConfiguration(TouchKeysConfig.GROUP, "bubble" + b.getIndex() + "X", b.getX());
+				configManager.setConfiguration(TouchKeysConfig.GROUP, "bubble" + b.getIndex() + "Y", b.getY());
+			}
+			else if (b.getMode() == KeyMode.HOLD && b.isKeyDown())
+			{
+				dispatcher.release(b.getKey());
+				b.setKeyDown(false);
+			}
+			return e;
+		}
+
+		@Override
+		public MouseEvent mouseClicked(MouseEvent e)
+		{
+			// The click that follows a bubble press/release must not reach the game either.
+			if (swallowNextClick)
+			{
+				swallowNextClick = false;
+				e.consume();
+			}
+			return e;
+		}
+	};
+
+	/** Topmost (last drawn) enabled bubble under the point, or null. */
+	private Bubble bubbleAt(Point p)
+	{
+		int size = config.bubbleSize();
+		for (int i = bubbles.size() - 1; i >= 0; i--)
+		{
+			Bubble b = bubbles.get(i);
+			if (b.isEnabled() && b.contains(p, size))
+			{
+				return b;
+			}
+		}
+		return null;
+	}
+
+	private void releaseEverything()
+	{
+		dispatcher.releaseAll();
+		activeBubble = null;
+		dragOffset = null;
+		for (Bubble b : bubbles)
+		{
+			b.setKeyDown(false);
+			b.setTouching(false);
+		}
+	}
+
+	private void loadBubbles()
+	{
+		for (Bubble b : bubbles)
+		{
+			switch (b.getIndex())
+			{
+				case 1:
+					apply(b, config.bubble1Enabled(), config.bubble1Key(), config.bubble1Mode(), config.bubble1Label(),
+						config.bubble1X(), config.bubble1Y());
+					break;
+				case 2:
+					apply(b, config.bubble2Enabled(), config.bubble2Key(), config.bubble2Mode(), config.bubble2Label(),
+						config.bubble2X(), config.bubble2Y());
+					break;
+				case 3:
+					apply(b, config.bubble3Enabled(), config.bubble3Key(), config.bubble3Mode(), config.bubble3Label(),
+						config.bubble3X(), config.bubble3Y());
+					break;
+				case 4:
+					apply(b, config.bubble4Enabled(), config.bubble4Key(), config.bubble4Mode(), config.bubble4Label(),
+						config.bubble4X(), config.bubble4Y());
+					break;
+			}
+		}
+	}
+
+	private static void apply(Bubble b, boolean enabled, KeyOption key, KeyMode mode, String label, int x, int y)
+	{
+		b.setEnabled(enabled);
+		b.setKey(key);
+		b.setMode(mode);
+		b.setLabel(label);
+		b.setX(x);
+		b.setY(y);
+	}
+
+	private static int clamp(int v, int min, int max)
+	{
+		return Math.max(min, Math.min(max, v));
+	}
+
+	private static void onEdt(Runnable r)
+	{
+		if (SwingUtilities.isEventDispatchThread())
+		{
+			r.run();
+		}
+		else
+		{
+			SwingUtilities.invokeLater(r);
+		}
+	}
+}

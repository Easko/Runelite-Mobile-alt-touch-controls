+package com.touchkeys;
+
+import java.awt.Color;
+import net.runelite.client.config.Alpha;
+import net.runelite.client.config.Config;
+import net.runelite.client.config.ConfigGroup;
+import net.runelite.client.config.ConfigItem;
+import net.runelite.client.config.ConfigSection;
+import net.runelite.client.config.Range;
+import net.runelite.client.config.Units;
+
+@ConfigGroup(TouchKeysConfig.GROUP)
+public interface TouchKeysConfig extends Config
+{
+	String GROUP = "touchkeys";
+
+	// ---------------------------------------------------------------- General
+
+	@ConfigSection(name = "General", description = "Settings for all bubbles", position = 0)
+	String general = "general";
+
+	@ConfigItem(
+		keyName = "editLayout",
+		name = "Move bubbles",
+		description = "While on, drag bubbles to move them. Bubbles don't send keys while this is on.",
+		position = 0,
+		section = general
+	)
+	default boolean editLayout()
+	{
+		return false;
+	}
+
+	@Range(min = 30, max = 200)
+	@Units(Units.PIXELS)
+	@ConfigItem(
+		keyName = "bubbleSize",
+		name = "Bubble size",
+		description = "Diameter of each bubble",
+		position = 1,
+		section = general
+	)
+	default int bubbleSize()
+	{
+		return 64;
+	}
+
+	@Alpha
+	@ConfigItem(
+		keyName = "idleColor",
+		name = "Idle color",
+		description = "Bubble color when its key is up",
+		position = 2,
+		section = general
+	)
+	default Color idleColor()
+	{
+		return new Color(20, 20, 20, 150);
+	}
+
+	@Alpha
+	@ConfigItem(
+		keyName = "activeColor",
+		name = "Pressed color",
+		description = "Bubble color while its key is down",
+		position = 3,
+		section = general
+	)
+	default Color activeColor()
+	{
+		return new Color(255, 180, 0, 200);
+	}
+
+	// ---------------------------------------------------------------- Bubble 1
+
+	@ConfigSection(name = "Bubble 1", description = "First bubble", position = 10)
+	String bubble1 = "bubble1";
+
+	@ConfigItem(keyName = "bubble1Enabled", name = "Show", description = "Show this bubble", position = 0, section = bubble1)
+	default boolean bubble1Enabled()
+	{
+		return true;
+	}
+
+	@ConfigItem(keyName = "bubble1Key", name = "Key", description = "Key this bubble acts as", position = 1, section = bubble1)
+	default KeyOption bubble1Key()
+	{
+		return KeyOption.SHIFT;
+	}
+
+	@ConfigItem(keyName = "bubble1Mode", name = "Mode",
+		description = "Hold: down while touched, up when you lift. Toggle: tap to lock down, tap again to release.",
+		position = 2, section = bubble1)
+	default KeyMode bubble1Mode()
+	{
+		return KeyMode.TOGGLE;
+	}
+
+	@ConfigItem(keyName = "bubble1Label", name = "Label", description = "Text on the bubble (blank = key name)", position = 3, section = bubble1)
+	default String bubble1Label()
+	{
+		return "";
+	}
+
+	@ConfigItem(keyName = "bubble1X", name = "", description = "", hidden = true)
+	default int bubble1X()
+	{
+		return 20;
+	}
+
+	@ConfigItem(keyName = "bubble1Y", name = "", description = "", hidden = true)
+	default int bubble1Y()
+	{
+		return 180;
+	}
+
+	// ---------------------------------------------------------------- Bubble 2
+
+	@ConfigSection(name = "Bubble 2", description = "Second bubble", position = 20)
+	String bubble2 = "bubble2";
+
+	@ConfigItem(keyName = "bubble2Enabled", name = "Show", description = "Show this bubble", position = 0, section = bubble2)
+	default boolean bubble2Enabled()
+	{
+		return true;
+	}
+
+	@ConfigItem(keyName = "bubble2Key", name = "Key", description = "Key this bubble acts as", position = 1, section = bubble2)
+	default KeyOption bubble2Key()
+	{
+		return KeyOption.SPACE;
+	}
+
+	@ConfigItem(keyName = "bubble2Mode", name = "Mode",
+		description = "Hold: down while touched, up when you lift. Toggle: tap to lock down, tap again to release.",
+		position = 2, section = bubble2)
+	default KeyMode bubble2Mode()
+	{
+		return KeyMode.HOLD;
+	}
+
+	@ConfigItem(keyName = "bubble2Label", name = "Label", description = "Text on the bubble (blank = key name)", position = 3, section = bubble2)
+	default String bubble2Label()
+	{
+		return "";
+	}
+
+	@ConfigItem(keyName = "bubble2X", name = "", description = "", hidden = true)
+	default int bubble2X()
+	{
+		return 20;
+	}
+
+	@ConfigItem(keyName = "bubble2Y", name = "", description = "", hidden = true)
+	default int bubble2Y()
+	{
+		return 260;
+	}
+
+	// ---------------------------------------------------------------- Bubble 3
+
+	@ConfigSection(name = "Bubble 3", description = "Third bubble", position = 30, closedByDefault = true)
+	String bubble3 = "bubble3";
+

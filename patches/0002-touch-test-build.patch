diff --git a/runelite-client/src/main/java/com/touchkeys/Bubble.java b/runelite-client/src/main/java/com/touchkeys/Bubble.java
new file mode 100644
index 0000000..2cda7c0
--- /dev/null
+++ b/runelite-client/src/main/java/com/touchkeys/Bubble.java
@@ -0,0 +1,38 @@
+package com.touchkeys;
+
+import java.awt.Point;
+import lombok.Data;
+
+/** One on-screen key. Settings come from config; the rest is live touch state. */
+@Data
+class Bubble
+{
+	private final int index;
+
+	// From config
+	private boolean enabled;
+	private KeyOption key;
+	private KeyMode mode;
+	private String label;
+	private int x;
+	private int y;
+
+	// Live state
+	/** A finger (or the mouse) is currently pressing this bubble. */
+	private boolean touching;
+	/** This bubble currently holds its key down (HOLD while touching, or TOGGLE latched). */
+	private boolean keyDown;
+
+	String displayLabel()
+	{
+		return label == null || label.trim().isEmpty() ? key.getLabel() : label.trim();
+	}
+
+	boolean contains(Point p, int size)
+	{
+		double r = size / 2.0;
+		double dx = p.x - (x + r);
+		double dy = p.y - (y + r);
+		return dx * dx + dy * dy <= r * r;
+	}
+}
diff --git a/runelite-client/src/main/java/com/touchkeys/KeyDispatcher.java b/runelite-client/src/main/java/com/touchkeys/KeyDispatcher.java
new file mode 100644
index 0000000..abb8606
--- /dev/null
+++ b/runelite-client/src/main/java/com/touchkeys/KeyDispatcher.java
@@ -0,0 +1,124 @@
+package com.touchkeys;
+
+import java.awt.Canvas;
+import java.awt.event.KeyEvent;
+import java.awt.event.KeyListener;
+import java.util.ArrayList;
+import java.util.EnumSet;
+import java.util.Set;
+import javax.inject.Inject;
+import javax.inject.Singleton;
+import net.runelite.api.Client;
+
+/**
+ * Sends key events to the game canvas the same way a physical keyboard does:
+ * KEY_PRESSED on the way down (followed by KEY_TYPED for keys that produce a
+ * character) and KEY_RELEASED on the way up, with the mask of every held
+ * modifier attached. Events are only ever sent in direct response to the
+ * player touching a bubble: one touch, one key action. Holding a bubble never
+ * repeats the key.
+ *
+ * All methods must be called on the Swing event dispatch thread.
+ */
+@Singleton
+public class KeyDispatcher
+{
+	private final Client client;
+	private final Set<KeyOption> held = EnumSet.noneOf(KeyOption.class);
+
+	@Inject
+	KeyDispatcher(Client client)
+	{
+		this.client = client;
+	}
+
+	public void press(KeyOption key)
+	{
+		held.add(key);
+		sendPressed(key);
+	}
+
+	public void release(KeyOption key)
+	{
+		if (!held.remove(key))
+		{
+			return;
+		}
+		Canvas canvas = client.getCanvas();
+		if (canvas == null)
+		{
+			return;
+		}
+		// Like AWT, the release event's modifiers no longer include the key being released.
+		deliver(canvas, new KeyEvent(canvas, KeyEvent.KEY_RELEASED, System.currentTimeMillis(),
+			modifiers(), key.getKeyCode(), key.getKeyChar(), key.getKeyLocation()));
+	}
+
+	public void releaseAll()
+	{
+		for (KeyOption key : new ArrayList<>(held))
+		{
+			release(key);
+		}
+	}
+
+	private void sendPressed(KeyOption key)
+	{
+		Canvas canvas = client.getCanvas();
+		if (canvas == null)
+		{
+			return;
+		}
+		long now = System.currentTimeMillis();
+		// Like AWT, a modifier's own press event already carries its mask.
+		int mods = modifiers();
+		deliver(canvas, new KeyEvent(canvas, KeyEvent.KEY_PRESSED, now, mods,
+			key.getKeyCode(), key.getKeyChar(), key.getKeyLocation()));
+
+		if (key.isTyped())
+		{
+			char c = key.getKeyChar();
+			if ((mods & KeyEvent.SHIFT_DOWN_MASK) != 0 && Character.isLetter(c))
+			{
+				c = Character.toUpperCase(c);
+			}
+			deliver(canvas, new KeyEvent(canvas, KeyEvent.KEY_TYPED, now, mods,
+				KeyEvent.VK_UNDEFINED, c, KeyEvent.KEY_LOCATION_UNKNOWN));
+		}
+	}
+
+	/**
+	 * Hands the event to the game canvas's key listeners (the game's keyboard
+	 * handler, which RuneLite's KeyManager hooks into) - the same place a physical
+	 * keypress ends up. Going through Component.dispatchEvent instead would route
+	 * it via the focus manager, which drops it whenever the canvas isn't focused.
+	 */
+	private static void deliver(Canvas canvas, KeyEvent e)
+	{
+		for (KeyListener l : canvas.getKeyListeners())
+		{
+			switch (e.getID())
+			{
+				case KeyEvent.KEY_PRESSED:
+					l.keyPressed(e);
+					break;
+				case KeyEvent.KEY_RELEASED:
+					l.keyReleased(e);
+					break;
+				case KeyEvent.KEY_TYPED:
+					l.keyTyped(e);
+					break;
+			}
+		}
+	}
+
+	private int modifiers()
+	{
+		int mask = 0;
+		for (KeyOption k : held)
+		{
+			mask |= k.getModifierMask();
+		}
+		return mask;
+	}
+}
diff --git a/runelite-client/src/main/java/com/touchkeys/KeyMode.java b/runelite-client/src/main/java/com/touchkeys/KeyMode.java
new file mode 100644

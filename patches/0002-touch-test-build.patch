+++ b/runelite-client/src/main/java/com/touchkeys/KeyMode.java
@@ -0,0 +1,22 @@
+package com.touchkeys;
+
+import lombok.Getter;
+import lombok.RequiredArgsConstructor;
+
+@Getter
+@RequiredArgsConstructor
+public enum KeyMode
+{
+	/** Key goes down when the bubble is touched and up when the touch ends. It never repeats while held. */
+	HOLD("Hold"),
+	/** First tap presses and locks the key down, the next tap releases it (sticky key). */
+	TOGGLE("Toggle (sticky)");
+
+	private final String label;
+
+	@Override
+	public String toString()
+	{
+		return label;
+	}
+}
diff --git a/runelite-client/src/main/java/com/touchkeys/KeyOption.java b/runelite-client/src/main/java/com/touchkeys/KeyOption.java
new file mode 100644

@@ -0,0 +1,122 @@
+package com.touchkeys;
+
+import java.awt.event.KeyEvent;
+import lombok.Getter;
+
+/**
+ * Every key a bubble can be programmed to act as. Each entry carries the same
+ * values a physical keyboard would put into an AWT KeyEvent.
+ */
+@Getter
+public enum KeyOption
+{
+	// Modifiers
+	SHIFT("Shift", KeyEvent.VK_SHIFT, KeyEvent.CHAR_UNDEFINED, KeyEvent.SHIFT_DOWN_MASK, KeyEvent.KEY_LOCATION_LEFT),
+	CTRL("Ctrl", KeyEvent.VK_CONTROL, KeyEvent.CHAR_UNDEFINED, KeyEvent.CTRL_DOWN_MASK, KeyEvent.KEY_LOCATION_LEFT),
+	ALT("Alt", KeyEvent.VK_ALT, KeyEvent.CHAR_UNDEFINED, KeyEvent.ALT_DOWN_MASK, KeyEvent.KEY_LOCATION_LEFT),
+
+	// Common keys
+	SPACE("Space", KeyEvent.VK_SPACE, ' '),
+	ENTER("Enter", KeyEvent.VK_ENTER, '\n'),
+	ESCAPE("Esc", KeyEvent.VK_ESCAPE, (char) 27),
+	BACKSPACE("Bksp", KeyEvent.VK_BACK_SPACE, '\b'),
+	TAB("Tab", KeyEvent.VK_TAB, '\t'),
+
+	// Number row
+	KEY_1("1", KeyEvent.VK_1, '1'),
+	KEY_2("2", KeyEvent.VK_2, '2'),
+	KEY_3("3", KeyEvent.VK_3, '3'),
+	KEY_4("4", KeyEvent.VK_4, '4'),
+	KEY_5("5", KeyEvent.VK_5, '5'),
+	KEY_6("6", KeyEvent.VK_6, '6'),
+	KEY_7("7", KeyEvent.VK_7, '7'),
+	KEY_8("8", KeyEvent.VK_8, '8'),
+	KEY_9("9", KeyEvent.VK_9, '9'),
+	KEY_0("0", KeyEvent.VK_0, '0'),
+
+	// Arrows
+	UP("Up", KeyEvent.VK_UP, KeyEvent.CHAR_UNDEFINED),
+	DOWN("Down", KeyEvent.VK_DOWN, KeyEvent.CHAR_UNDEFINED),
+	LEFT("Left", KeyEvent.VK_LEFT, KeyEvent.CHAR_UNDEFINED),
+	RIGHT("Right", KeyEvent.VK_RIGHT, KeyEvent.CHAR_UNDEFINED),
+
+	// Function keys
+	F1("F1", KeyEvent.VK_F1, KeyEvent.CHAR_UNDEFINED),
+	F2("F2", KeyEvent.VK_F2, KeyEvent.CHAR_UNDEFINED),
+	F3("F3", KeyEvent.VK_F3, KeyEvent.CHAR_UNDEFINED),
+	F4("F4", KeyEvent.VK_F4, KeyEvent.CHAR_UNDEFINED),
+	F5("F5", KeyEvent.VK_F5, KeyEvent.CHAR_UNDEFINED),
+	F6("F6", KeyEvent.VK_F6, KeyEvent.CHAR_UNDEFINED),
+	F7("F7", KeyEvent.VK_F7, KeyEvent.CHAR_UNDEFINED),
+	F8("F8", KeyEvent.VK_F8, KeyEvent.CHAR_UNDEFINED),
+	F9("F9", KeyEvent.VK_F9, KeyEvent.CHAR_UNDEFINED),
+	F10("F10", KeyEvent.VK_F10, KeyEvent.CHAR_UNDEFINED),
+	F11("F11", KeyEvent.VK_F11, KeyEvent.CHAR_UNDEFINED),
+	F12("F12", KeyEvent.VK_F12, KeyEvent.CHAR_UNDEFINED),
+
+	// Letters
+	A("A", KeyEvent.VK_A, 'a'),
+	B("B", KeyEvent.VK_B, 'b'),
+	C("C", KeyEvent.VK_C, 'c'),
+	D("D", KeyEvent.VK_D, 'd'),
+	E("E", KeyEvent.VK_E, 'e'),
+	F("F", KeyEvent.VK_F, 'f'),
+	G("G", KeyEvent.VK_G, 'g'),
+	H("H", KeyEvent.VK_H, 'h'),
+	I("I", KeyEvent.VK_I, 'i'),
+	J("J", KeyEvent.VK_J, 'j'),
+	K("K", KeyEvent.VK_K, 'k'),
+	L("L", KeyEvent.VK_L, 'l'),
+	M("M", KeyEvent.VK_M, 'm'),
+	N("N", KeyEvent.VK_N, 'n'),
+	O("O", KeyEvent.VK_O, 'o'),
+	P("P", KeyEvent.VK_P, 'p'),
+	Q("Q", KeyEvent.VK_Q, 'q'),
+	R("R", KeyEvent.VK_R, 'r'),
+	S("S", KeyEvent.VK_S, 's'),
+	T("T", KeyEvent.VK_T, 't'),
+	U("U", KeyEvent.VK_U, 'u'),
+	V("V", KeyEvent.VK_V, 'v'),
+	W("W", KeyEvent.VK_W, 'w'),
+	X("X", KeyEvent.VK_X, 'x'),
+	Y("Y", KeyEvent.VK_Y, 'y'),
+	Z("Z", KeyEvent.VK_Z, 'z');
+
+	private final String label;
+	private final int keyCode;
+	private final char keyChar;
+	/** Non-zero only for modifier keys: the mask this key adds while held. */
+	private final int modifierMask;
+	private final int keyLocation;
+
+	KeyOption(String label, int keyCode, char keyChar)
+	{
+		this(label, keyCode, keyChar, 0, KeyEvent.KEY_LOCATION_STANDARD);
+	}
+
+	KeyOption(String label, int keyCode, char keyChar, int modifierMask, int keyLocation)
+	{
+		this.label = label;
+		this.keyCode = keyCode;
+		this.keyChar = keyChar;
+		this.modifierMask = modifierMask;
+		this.keyLocation = keyLocation;
+	}
+
+	public boolean isModifier()
+	{
+		return modifierMask != 0;
+	}
+
+	/** True if a real keyboard would also send a KEY_TYPED character for this key. */
+	public boolean isTyped()
+	{
+		return keyChar != KeyEvent.CHAR_UNDEFINED;
+	}
+
+	@Override
+	public String toString()
+	{
+		return label;
+	}
+}
